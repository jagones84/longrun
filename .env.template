# Longrun environment template — copy to `.env` and fill in (JAG-71).
#
#   cp .env.template .env      # .env is gitignored and NEVER committed
#
# `config/providers.yaml` references these keys by NAME, so this file is the
# only place a secret lives. The harness also reads ~/.hermes/.env if present,
# and the first value found wins (existing environment variables are never
# overwritten).

# --- cloud providers -----------------------------------------------------------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- optional local keys (only if your local servers require one) --------------
# VLLM_API_KEY=
# LOCAL_LLAMA_API_KEY=

# --- harness auth (the token the WebUI must use to reach the API) ------------
# The token gates every API route. The WebUI accepts it as `?token=<value>` in
# the URL (e.g. http://100.102.61.23:8790/?token=...) and the CLI / curl as
# `Authorization: Bearer <value>`. When empty, the server starts with no auth
# (localhost-only is fine; LAN/Tailscale exposure becomes a risk).
#
# Where to find the current value (DGX, in this workspace):
#   grep ^LONGRUN_TOKEN ~/.config/longrun/env
# On the local Windows PC, the same key is set by longrun.service from
#   C:\Users\giova\.hermes\.env  (or `deploy/longrun.service` EnvironmentFile=).
#
# Pick any non-empty string; restart the server / reload the unit to apply.
LONGRUN_TOKEN=
