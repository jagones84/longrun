# Longrun environment template — copy to `.env` and fill in (JAG-71 / JAG-492).
#
#   cp .env.template .env      # `.env` is gitignored and NEVER committed
#
# `config/providers.yaml` references keys by NAME. The WebUI's Settings ▸ Keys
# writes this file for you. It is the shared secret store for interactive runs
# and the systemd unit; `LONGRUN_ENV_FILE` can select an alternate file.

# --- chat providers -------------------------------------------------------------
# Pick ONE — or don't set any and run a local llama.cpp router on :8080.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional cloud providers (only if you use their models):
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=

# --- embedding-only providers (optional, config/embedding.yaml) -----------------
#COHERE_API_KEY=
#VOYAGE_API_KEY=
#JINA_API_KEY=

# --- tools (all optional) -------------------------------------------------------
#TAVILY_API_KEY=       # web search; without it a keyless DuckDuckGo search is used
#BRAVE_API_KEY=
#GITHUB_TOKEN=         # github tool
#PERPLEXITY_API_KEY=   # research provider

# --- local servers (only if yours require a key) --------------------------------
#VLLM_API_KEY=

# --- harness auth ---------------------------------------------------------------
# Set a value to gate every API/data route: the WebUI then asks for this token once
# per browser (the static page stays public so it can show the prompt), the CLI and
# the raw API send `Authorization: Bearer <value>`. Leave empty for no auth (fine on
# localhost, risky on LAN/Tailscale). `--token` on the command line wins over this
# value. The local-only first-run panel writes this line for you. The systemd unit
# reads this same repo-root `.env`, so WebUI token changes survive service restarts.
LONGRUN_TOKEN=
