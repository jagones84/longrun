#!/bin/sh
# Flaky scanner: the first two runs of a fresh workspace refuse with a lock.
mkdir -p state
f=state/.scan_attempts
n=$(cat "$f" 2>/dev/null || echo 0)
n=$((n + 1))
printf '%s\n' "$n" > "$f"
if [ "$n" -le 2 ]; then
  echo "scan: temporary lock (attempt $n)" >&2
  exit 3
fi
tr 'a-z' 'n-za-m' < "$1"
