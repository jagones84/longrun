__pycache__/
.pytest_cache/
data/
*.log
.venv/
eval/results/

# Agent working memory (HANDOFF + per-domain manuals): local operational state,
# never part of the shipped repo.
.agent/
.Matrix/

# Matrix scratch/test scripts must NEVER be tracked. `.Matrix/` above already
# ignores the whole tree; this explicit rule keeps trash ignored even if a later
# change starts tracking parts of .Matrix (e.g. rules/ or docs/).
.Matrix/trash/


# JAG-180: editor/agent backup + temp files must never reach the repo.
*.bak
*.bak-*
*.orig
*.tmp

# Secrets — NEVER commit API keys (JAG-71). Providers reference their key by
# env-var name and the values live in a .env / ~/.hermes/.env, both ignored here.
.env
.env.*
*/.env
*/.env.*
!.env.template

# Ephemeral agent helpers / temp test harnesses (workspace rule: keep trash out
# of the repo; official scripts live at the repo root or under scripts/).
trash/

# Agent-produced audit/test deliverables (`reports/…`) are the output of ONE run,
# exactly like `trash/` — never a shipped artifact. `88f774c` tracked four such
# files by accident; v787 removed them from the index and they stay on disk only
# as long as a run needs them.
reports/

# Benchmark/eval environments produced by one research run (builder script +
# generated workspace, scoring output and logs). Local artifact, never shipped.
envs/

# JAG-108: user-added external MCP clients are persisted here (commands, headers
# and tokens must never reach the tracked repo).
config/mcp_clients.local.yaml
config/mcp_clients.local.json

# JAG-109: the user's personal skill library (symlinked categories under
# skills/) is LOCAL-ONLY and never in the repo; user-uploaded skills (zip) also
# land under skills/. The only tracked skill is the first-party orientation skill
# in skills/core/.
skills/*
!skills/core/
!skills/core/**

# JAG-112: user-added/overridden providers land here (never the tracked base).
config/providers.local.yaml

# JAG-487/495: the auto-compact policy overlay written by the WebUI auto-save is
# per-machine local state (never the tracked base config/compaction.yaml).
config/compaction.local.yaml

# RH-28: the bootstrap config.json is per-machine runtime state, never a shipped
# default — `remember_workspace()` keeps the LAST folder opened on THIS machine
# (paths.config_file()). Tracking it would push one operator's workspace path to
# every checkout; the app recreates it on demand.
config/config.json

.superpowers/

# JAG-311: the e2e WebUI test project (Node). It consumes the sibling cloned
# `tester-army/e2e` framework via file: links; its own .gitignore drops the
# node_modules and .e2e/, and the whole folder is kept local (not part of the
# Python package). Remove this line to version the tests.
e2e/

# refactor-20261006: generated, never track
outputs/
mutants/
tests/.e2e/
tests/battery.ps1
.battery-fails-*/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.nightly_stop
nohup.out

# The targeted battery launcher is rewritten per fix (README: "overwritten per
# fix") and carries this machine's absolute checkout path. Per-machine scratch,
# never shipped — same reason as tests/battery.ps1 above.
tests/battery_tmp.sh

# Legacy root-level data dirs: session transcripts and plan/task graphs now live
# under data/ (paths.SESSIONS_DIR / GRAPH_DIR). Empty leftovers on old checkouts
# must not start tracking whatever an old code path drops there.
graphs/
sessions/

# Device/UI screenshots captured by the Android/browser QA tooling at the repo
# root. Generated evidence, one run only.
.screenshots/

# Packaging/build output (no pyproject today, but pip build/install would drop
# these here and they are never source).
*.egg-info/
dist/
build/
.coverage
.coverage.*
htmlcov/

# archify: transient preview dirs left by the architecture-diagram generator.
.archify-preview-*/

# archify: per-request working folder (candidate draft, finalize/browser receipts,
# the rendered page). Generated output, not source: the DELIVERED page is kept in
# the local proposal store (.agent/docs/proposals/<month>/) or docs/ when tracked.
.archify/

# .trae share bundles: the SAME generated pages as above, re-exported as .zip for
# handing to the operator. Generated output, not source (see the .archify/ note).
.trae-html-share-packages/

# archify: build artifact regenerated from docs/diagrams/longrun-architecture.architecture.json
# Source of truth is the .architecture.json; the HTML is regenerated by `node archify render`.
docs/diagrams/longrun-architecture.html

# Working memory kept LOCAL only: the dated historical record (docs/archive) and
# the superseded test set (tests/legacy — never discovered by the gate, which runs
# only tests/acceptance/v*.py). Both stay on disk, neither ships in the repo.
docs/archive/
tests/legacy/

# Design/research workspaces and generated diagram bundles are local artifacts:
# keep them on disk for reference, never in the shipped repository. The one
# exception is the architecture figure the README embeds: that IMAGE (not the
# bundle) is a deliverable, so it ships from docs/diagrams/ next to its spec.
docs/superpowers/
docs/diagrams/*
!docs/diagrams/architecture.svg

# Hypothesis property-test database (tests/properties).
.hypothesis/

# Compiled Python that escapes a __pycache__ dir (e.g. hand-copied artifacts).
*.pyc
*.pyo

# JAG-465: the Trae IDE keeps its agent rules and session state here. It is local
# machine state (it can carry an auth URL) and must never be tracked. The files stay
# on disk — untracked, not deleted (`git rm -r --cached .trae`).
.trae/

# JAG-2.9: `.longrun/` is per-machine operational state. It is no longer created
# by the harness (JAG-534 moved project rules to the data home), but a stale
# checkout must not suddenly start tracking it. `.gitignore`d, never committed.
# v1051c (operator, 2026-11-16): `/plan` and `/spec` write their deliverables under
# `<workspace>/.longrun/documents/`, which may be THIS repo when you work on the
# harness itself — a deliverable is local output, not shipped source, so the whole
# tree is ignored. The files stay on disk; only git stops seeing them.
.longrun/

# OS / editor cruft (never share a machine's local state).
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

