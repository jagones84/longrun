__pycache__/
.pytest_cache/
data/
*.log
.venv/
eval/results/

# Agent working memory (HANDOFF + per-domain manuals): local operational state,
# never part of the shipped repo.
.agent/
.Matrix/

# Matrix scratch/test scripts must NEVER be tracked. `.Matrix/` above already
# ignores the whole tree; this explicit rule keeps trash ignored even if a later
# change starts tracking parts of .Matrix (e.g. rules/ or docs/).
.Matrix/trash/


# JAG-180: editor/agent backup + temp files must never reach the repo.
*.bak
*.bak-*
*.orig
*.tmp

# Secrets — NEVER commit API keys (JAG-71). Providers reference their key by
# env-var name and the values live in a .env / ~/.hermes/.env, both ignored here.
.env
.env.*
*/.env
*/.env.*
!.env.template

# Ephemeral agent helpers / temp test harnesses (workspace rule: keep trash out
# of the repo; official scripts live at the repo root or under scripts/).
trash/

# JAG-108: user-added external MCP clients are persisted here (commands, headers
# and tokens must never reach the tracked repo).
config/mcp_clients.local.yaml
config/mcp_clients.local.json

# JAG-109: the user's personal skill library (symlinked categories under
# skills/) is LOCAL-ONLY and never in the repo; user-uploaded skills (zip) also
# land under skills/. The only tracked skill is the first-party orientation skill
# in skills/core/.
skills/*
!skills/core/
!skills/core/**

# JAG-112: user-added/overridden providers land here (never the tracked base).
config/providers.local.yaml

.superpowers/

# JAG-311: the e2e WebUI test project (Node). It consumes the sibling cloned
# `tester-army/e2e` framework via file: links; its own .gitignore drops the
# node_modules and .e2e/, and the whole folder is kept local (not part of the
# Python package). Remove this line to version the tests.
e2e/

# refactor-20261006: generated, never track
outputs/
mutants/
tests/.e2e/
tests/battery.ps1
.battery-fails-*/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.nightly_stop
nohup.out

# archify: transient preview dirs left by the architecture-diagram generator.
.archify-preview-*/

# archify: build artifact regenerated from docs/diagrams/longrun-architecture.architecture.json
# Source of truth is the .architecture.json; the HTML is regenerated by `node archify render`.
docs/diagrams/longrun-architecture.html

# Working memory kept LOCAL only: the dated historical record (docs/archive) and
# the superseded test set (tests/legacy — never discovered by the gate, which runs
# only tests/acceptance/v*.py). Both stay on disk, neither ships in the repo.
docs/archive/
tests/legacy/

# Hypothesis property-test database (tests/properties).
.hypothesis/

# Compiled Python that escapes a __pycache__ dir (e.g. hand-copied artifacts).
*.pyc
*.pyo

# JAG-465: the Trae IDE keeps its agent rules and session state here. It is local
# machine state (it can carry an auth URL) and must never be tracked. The files stay
# on disk — untracked, not deleted (`git rm -r --cached .trae`).
.trae/

# OS / editor cruft (never share a machine's local state).
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

